OOM_STORE_BACKEND=postgres
OOM_POSTGRES_DSN=postgresql+asyncpg://user:password@host:5432/oom
# Optional when OOM_POSTGRES_DSN user cannot create databases:
# OOM_POSTGRES_ADMIN_DSN=postgresql+asyncpg://admin:password@host:5432/postgres
# Optional worker identifier for DB-backed pipeline workers:
# OOM_WORKER_ID=worker-1
# Optional checkpoint file for pipeline state recovery:
# OOM_PIPELINE_CHECKPOINT_PATH=.oom/pipeline.json
# Optional directory for offloaded raw refs:
# OOM_DATA_DIR=.oom/offload
